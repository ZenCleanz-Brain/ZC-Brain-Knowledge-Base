# ─────────────────────────────────────────────────────────────────────────────
# Team-Portal environment variables (EXAMPLE — no real secrets here)
# Copy to .env / .env.local and fill in real values. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# The URL is NOT secret. Used by server code (SUPABASE_URL) and for the public
# storage video links in the UI (NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# SERVER-ONLY secret key (Supabase dashboard → Project Settings → API keys).
# This key BYPASSES Row Level Security, so it must stay server-side ONLY.
# DO NOT prefix with NEXT_PUBLIC_ — that would inline it into the browser bundle.
# Only used by lib/supabase/server.ts (guarded with `import 'server-only'`).
SUPABASE_SECRET_KEY=sb_secret_replace_me

# ── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=replace_with_a_long_random_string
NEXTAUTH_URL=http://localhost:3000

# Users — SIMPLE FORMAT: username:password:role (comma-separated)
# Roles: admin, editor, viewer
# NOTE: passwords are currently stored/compared in plaintext (see lib/auth.ts).
USERS=admin:changeme:admin,editor:changeme:editor

# ── GitHub API (for commits) ────────────────────────────────────────────────
GITHUB_TOKEN=ghp_replace_me
GITHUB_OWNER=your-github-org
GITHUB_REPO=your-repo
GITHUB_BRANCH=master

# ── Knowledge Base path (relative to repo root) ─────────────────────────────
KB_BASE_PATH=PUBLISHED FOLDERS MASTER

# ── n8n Workflow (optional) ─────────────────────────────────────────────────
N8N_BASE_URL=https://your-n8n-host
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/kb-update
N8N_API_KEY=replace_me
NOTIFICATION_WEBHOOK_URL=

# ── ElevenLabs (voice AI) ───────────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_replace_me
ELEVENLABS_AGENT_ID=agent_replace_me
ELEVENLABS_SUB_AGENT_1=agent_id_1
ELEVENLABS_SUB_AGENT_2=agent_id_2
ELEVENLABS_SUB_AGENT_3=agent_id_3

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-replace_me
